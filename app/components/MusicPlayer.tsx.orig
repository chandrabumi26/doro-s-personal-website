"use client";

import { useState, useRef, useEffect } from "react";
import { motion, AnimatePresence } from "motion/react";
import Image from "next/image";

export default function MusicPlayer() {
  const [isPlaying, setIsPlaying] = useState(false);
  const [isVisible, setIsVisible] = useState(true);
  const [progress, setProgress] = useState(0);
  const [volume, setVolume] = useState(0.1); // 10% default volume
  const [isVolumeHovered, setIsVolumeHovered] = useState(false);

  const audioRef = useRef<HTMLAudioElement | null>(null);
  const autoplayTimerRef = useRef<NodeJS.Timeout | null>(null);
  const isManuallyControlledRef = useRef(false);

  // Initialize audio and auto-unlock
  useEffect(() => {
    const audio = new Audio("/music/Blur-The-Narcissist-(Instrumental).mp3");
    audio.loop = true;
    audioRef.current = audio;

    // Set initial volume to 10%
    audio.volume = 0.1;

    const attemptPlay = () => {
      if (isManuallyControlledRef.current || !audioRef.current) return;

      audioRef.current.play()
        .then(() => {
          setIsPlaying(true);
          cleanup();
        })
        .catch((e) => console.log("Autoplay blocked, waiting for user interaction."));
    };

    const cleanup = () => {
      window.removeEventListener("click", attemptPlay);
      window.removeEventListener("touchstart", attemptPlay);
      window.removeEventListener("wheel", attemptPlay);
      window.removeEventListener("keydown", attemptPlay);
      window.removeEventListener("scroll", attemptPlay, true);
    };

    // Handle autoplay after 3 seconds (if browser policies allow without interaction)
    autoplayTimerRef.current = setTimeout(() => {
      attemptPlay();
    }, 3000);

    // Play immediately upon user scrolling, clicking, touching, or typing
    window.addEventListener("click", attemptPlay, { once: true });
    window.addEventListener("touchstart", attemptPlay, { once: true, passive: true });
    window.addEventListener("wheel", attemptPlay, { once: true, passive: true }); // Mouse wheel scroll
    window.addEventListener("keydown", attemptPlay, { once: true, passive: true }); // Keyboard scroll
    window.addEventListener("scroll", attemptPlay, { once: true, capture: true, passive: true }); // Scrollbar drag

    return () => {
      if (autoplayTimerRef.current) clearTimeout(autoplayTimerRef.current);
      cleanup();
    };
  }, []);

  // Apply volume changes
  useEffect(() => {
    if (audioRef.current) {
      audioRef.current.volume = volume;
    }
  }, [volume]);

  // Handle Play/Pause toggle
  const togglePlay = async () => {
    if (!audioRef.current) return;
    isManuallyControlledRef.current = true;

    if (autoplayTimerRef.current) {
      clearTimeout(autoplayTimerRef.current);
      autoplayTimerRef.current = null;
    }

    try {
      if (isPlaying) {
        audioRef.current.pause();
        setIsPlaying(false);
      } else {
        await audioRef.current.play();
        setIsPlaying(true);
      }
    } catch (err) {
      console.error("Audio playback failed:", err);
    }
  };

  const handleTimeUpdate = () => {
    if (!audioRef.current) return;
    const current = audioRef.current.currentTime;
    const duration = audioRef.current.duration;
    if (duration) {
      setProgress((current / duration) * 100);
    }
  };

  // Setup HTML5 Audio listeners manually on initialization
  useEffect(() => {
    const checkAudio = () => {
      if (audioRef.current) {
        audioRef.current.ontimeupdate = handleTimeUpdate;
        // Audio has loop=true, so it won't naturally end, but if it does, we restart it
        audioRef.current.onended = () => {
          if (audioRef.current) {
            audioRef.current.currentTime = 0;
            audioRef.current.play().catch(() => {});
          }
        };
      }
    };
    const timer = setInterval(checkAudio, 100);
    return () => clearInterval(timer);
  }, []);

  const handleVolumeChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const newVolume = parseFloat(e.target.value);
    setVolume(newVolume);
  };

  return (
    <>
      <AnimatePresence>
        {isVisible && (
          <motion.div
            key="player"
            initial={{ opacity: 0, y: 50, scale: 0.95 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: 50, scale: 0.95 }}
            transition={{ type: "spring", stiffness: 300, damping: 25 }}
            className="fixed bottom-6 right-6 z-50 pointer-events-auto"
          >
            <motion.div
              whileHover={{
                scale: 1.03,
                boxShadow: "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
              }}
              transition={{ type: "spring", stiffness: 400, damping: 17 }}
              className="w-72 sm:w-80 bg-cream/95 backdrop-blur-md border border-charcoal/15 rounded-2xl shadow-xl overflow-hidden flex flex-col retro-texture"
            >
              {/* Progress bar */}
              <div className="w-full h-1 bg-charcoal/10 relative">
                <motion.div
                  className="h-full bg-tosca absolute top-0 left-0"
                  style={{ width: `${progress}%` }}
                  transition={{ ease: "linear" }}
                />
              </div>

              <div className="flex items-center justify-between p-4 gap-3">
                {/* Album Art */}
                <div className="relative w-12 h-12 rounded-lg overflow-hidden border border-charcoal/10 flex-shrink-0">
                  <Image
                    src="/music/images/blue-the-narcissist.png"
                    alt="Blur - The Narcissist"
                    fill
                    sizes="48px"
                    className="object-cover"
                  />
                </div>

                {/* Track Details */}
                <div className="flex-1 min-w-0">
                  <p className="text-sm font-bold text-charcoal truncate">
                    The Narcissist
                  </p>
                  <AnimatePresence mode="wait">
                    {isPlaying ? (
                      <motion.p
                        key="playing"
                        initial={{ opacity: 0, y: 5 }}
                        animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, y: -5 }}
                        className="text-xs text-charcoal/60 truncate"
                      >
                        Blur (Instrumental)
                      </motion.p>
                    ) : (
                      <motion.p
                        key="paused"
                        initial={{ opacity: 0, y: 5 }}
                        animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, y: -5 }}
                        className="text-[10px] sm:text-xs text-tosca-dark font-medium truncate animate-pulse"
                      >
                        Best experienced with sound ✨
                      </motion.p>
                    )}
                  </AnimatePresence>
                </div>

                {/* Controls */}
                <div className="flex items-center gap-2">
                  {/* Expandable Volume Slider on Hover */}
                  <div
                    className="relative flex items-center h-8 bg-charcoal/5 rounded-full px-2"
                    onMouseEnter={() => setIsVolumeHovered(true)}
                    onMouseLeave={() => setIsVolumeHovered(false)}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="2"
                      className="w-4 h-4 text-charcoal/70 flex-shrink-0"
                    >
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07" />
                    </svg>

                    <motion.div
                      initial={{ width: 0, opacity: 0, marginLeft: 0 }}
                      animate={{
                        width: isVolumeHovered ? 64 : 0,
                        opacity: isVolumeHovered ? 1 : 0,
                        marginLeft: isVolumeHovered ? 8 : 0
                      }}
                      transition={{ duration: 0.2, ease: "easeOut" }}
                      className="overflow-hidden flex items-center"
                    >
                      <input
                        type="range"
                        min="0"
                        max="1"
                        step="0.01"
                        value={volume}
                        onChange={handleVolumeChange}
                        className="w-16 h-1 appearance-none bg-charcoal/20 rounded-full accent-tosca cursor-pointer"
                      />
                    </motion.div>
                  </div>

                  {/* Play/Pause Button */}
                  <motion.button
                    whileHover={{ scale: 1.1 }}
                    whileTap={{ scale: 0.9 }}
                    onClick={togglePlay}
                    className="w-9 h-9 rounded-full bg-tosca text-cream flex items-center justify-center shadow-md hover:bg-tosca-dark transition-colors cursor-pointer"
                  >
                    {isPlaying ? (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        className="w-4 h-4 text-cream"
                      >
                        <path
                          fillRule="evenodd"
                          d="M6.75 5.25a.75.75 0 0 1 .75-.75H9a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H7.5a.75.75 0 0 1-.75-.75V5.25Zm7.5 0A.75.75 0 0 1 15 4.5h1.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H15a.75.75 0 0 1-.75-.75V5.25Z"
                          clipRule="evenodd"
                        />
                      </svg>
                    ) : (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        className="w-4 h-4 ml-0.5 text-cream"
                      >
                        <path
                          fillRule="evenodd"
                          d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
                          clipRule="evenodd"
                        />
                      </svg>
                    )}
                  </motion.button>

                  {/* Close/Turn Off Button */}
                  <motion.button
                    whileHover={{ scale: 1.1 }}
                    whileTap={{ scale: 0.9 }}
                    onClick={() => {
                      if (audioRef.current) audioRef.current.pause();
                      setIsPlaying(false);
                      setIsVisible(false);
                      isManuallyControlledRef.current = true;
                    }}
                    className="w-6 h-6 rounded-full bg-charcoal/10 hover:bg-charcoal/20 text-charcoal/60 flex items-center justify-center transition-colors cursor-pointer"
                    title="Turn off player"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="2.5"
                      className="w-3.5 h-3.5"
                    >
                      <path
                        strokeLinecap="round"
                        strokeLinejoin="round"
                        d="M6 18L18 6M6 6l12 12"
                      />
                    </svg>
                  </motion.button>
                </div>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Small restore pill if closed */}
      {!isVisible && (
        <motion.button
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          whileHover={{ scale: 1.05 }}
          whileTap={{ scale: 0.95 }}
          onClick={() => {
            setIsVisible(true);
            isManuallyControlledRef.current = true;
          }}
          className="fixed bottom-6 right-6 z-50 px-4 py-2 bg-cream/90 backdrop-blur-md border border-charcoal/15 rounded-full shadow-lg text-xs font-bold text-charcoal flex items-center gap-2 hover:bg-cream transition-colors cursor-pointer"
          title="Restore music player"
        >
          <span className="w-2 h-2 rounded-full bg-tosca animate-pulse" />
          Music Player
        </motion.button>
      )}
    </>
  );
}